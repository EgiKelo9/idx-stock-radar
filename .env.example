# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id_here

# LLM Sentiment Analysis Configuration
# Supported providers: "openrouter" (free tier default), "openai", "anthropic"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=10
LLM_MAX_WORDS=500

# Database Configuration (TimescaleDB / PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idx_market_db
DB_USER=postgres
DB_PASSWORD=idxpassword

# Market Screening & Quantitative Parameters
MIN_TURNOVER=1000000000
VOLUME_SPIKE_THRESHOLD=1.5
VOLUME_AVG_DAYS=20
RSI_PERIOD=14
ATR_PERIOD=14
SMA_FAST=20
SMA_MID=50
SMA_SLOW=200

# Risk Management Parameters
ATR_SL_MULTIPLIER=1.5
MIN_RRR=2.0
ARA_BUFFER_PERCENT=1.5
ARA_BUFFER_TICKS=2

# Scheduler & Universe Settings
SCAN_INTERVAL_MINUTES=15
TZ=Asia/Jakarta
TICKER_BOARDS=UTAMA,PENGEMBANGAN
TICKER_CACHE_TTL_HOURS=6
